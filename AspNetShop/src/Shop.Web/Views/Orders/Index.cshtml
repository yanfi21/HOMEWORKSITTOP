@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "Мои заказы";
}
<h1>Мои заказы</h1>

@if (Model.Count == 0)
{
    <div class="empty-state card">
        <h3>Заказов пока нет</h3>
        <a class="btn" asp-controller="Products" asp-action="Index">Выбрать товар</a>
    </div>
}
else
{
    <div class="card">
        <table class="table">
            <thead><tr><th>№</th><th>Дата</th><th>Товаров</th><th>Сумма</th><th>Статус</th><th></th></tr></thead>
            <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>#@order.Id</td>
                    <td>@order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@order.Items.Sum(i => i.Quantity)</td>
                    <td><strong>@order.Total.ToString("N0") ₽</strong></td>
                    <td><partial name="_OrderStatus" model="order.Status" /></td>
                    <td><a asp-action="Details" asp-route-id="@order.Id">Подробнее</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
