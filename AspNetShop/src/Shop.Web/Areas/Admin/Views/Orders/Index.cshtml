@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "Заказы";
}
<h1>Заказы</h1>
<section class="card">
    @if (Model.Count == 0)
    {
        <p class="muted">Заказов пока нет.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>№</th><th>Дата</th><th>Покупатель</th><th>Телефон</th><th>Сумма</th><th>Статус</th><th>Сменить статус</th></tr></thead>
            <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@o.Id">#@o.Id</a></td>
                    <td>@o.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@o.CustomerName<br /><span class="muted">@o.User?.Email</span></td>
                    <td>@o.Phone</td>
                    <td><strong>@o.Total.ToString("N0") ₽</strong></td>
                    <td>@o.Status</td>
                    <td>
                        <form asp-action="UpdateStatus" asp-route-id="@o.Id" method="post" class="status-form">
                            <select name="status">
                                @foreach (var status in Enum.GetValues<OrderStatus>())
                                {
                                    if (status == o.Status)
                                    {
                                        <option value="@status" selected>@status</option>
                                    }
                                    else
                                    {
                                        <option value="@status">@status</option>
                                    }
                                }
                            </select>
                            <button type="submit" class="btn btn-small">OK</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
