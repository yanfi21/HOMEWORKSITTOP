@model Product
@{
    ViewData["Title"] = "Редактирование товара";
}
<h1>Товар №@Model.Id</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card form-card wide">
    <input type="hidden" asp-for="Id" />
    <partial name="_ProductForm" model="Model" />
    <button type="submit" class="btn btn-block">Сохранить</button>
    <a asp-action="Index">← К списку</a>
</form>
