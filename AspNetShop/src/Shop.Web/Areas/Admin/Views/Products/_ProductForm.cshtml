@model Product
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<label asp-for="Name"></label>
<input asp-for="Name" />
<span asp-validation-for="Name" class="field-error"></span>

<label asp-for="Description"></label>
<textarea asp-for="Description" rows="4"></textarea>
<span asp-validation-for="Description" class="field-error"></span>

<label asp-for="CategoryId"></label>
<select asp-for="CategoryId" asp-items="ViewBag.Categories"></select>
<span asp-validation-for="CategoryId" class="field-error"></span>

<div class="form-row">
    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" step="0.01" min="0" />
        <span asp-validation-for="Price" class="field-error"></span>
    </div>
    <div>
        <label asp-for="OldPrice"></label>
        <input asp-for="OldPrice" type="number" step="0.01" min="0" />
    </div>
    <div>
        <label asp-for="Stock"></label>
        <input asp-for="Stock" type="number" min="0" />
        <span asp-validation-for="Stock" class="field-error"></span>
    </div>
</div>

<label asp-for="ImageUrl">Ссылка на картинку (или загрузите файл ниже)</label>
<input asp-for="ImageUrl" placeholder="/images/products/phone1.svg" />
<label>Загрузить картинку (jpg/png/webp, до 2 МБ)</label>
<input type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp" />

<label class="checkbox"><input asp-for="IsFeatured" /> Показывать на главной («Хит»)</label>
<label class="checkbox"><input asp-for="IsActive" /> Товар активен (виден в каталоге)</label>
